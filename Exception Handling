
#include <iostream>
using namespace std;

int main() {
    int a, b;

    cout << "Enter the numerator: ";
    cin >> a;

    cout << "Enter the denominator: ";
    cin >> b;

    try {
        if (b == 0) {
            throw b;
        }

        cout << "Result = " << (double)a / b << endl;
    }
    catch (int x) {
        cout << "Exception caught: Division by zero is not allowed."
             << endl;
    }

    cout << "Program continues normally." << endl;

    return 0;
}
